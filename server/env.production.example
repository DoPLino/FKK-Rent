NODE_ENV=production
PORT=8080
# Required in production. Example Atlas URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/filmequipment
MONGODB_URI=

# Safety: never enable dev login in production
ENABLE_DEV_LOGIN=false
JWT_ALGORITHM=HS256
# REQUIRED
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# REQUIRED (comma-separated for multiple origins)
CORS_ORIGIN=
# Enable CORS credentials only if you serve cookies/Authorization headers cross-origin
CORS_CREDENTIALS=false
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
MAX_FILES_PER_USER=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf

# Email (recommended for production)
# Explicit sender
EMAIL_FROM=
# SMTP with OAuth2 (recommended if using SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Or use a provider API (preferred)
SENDGRID_API_KEY=

