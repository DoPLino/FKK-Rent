PORT=0
NODE_ENV=test
MONGODB_URI=mongodb://localhost:27017/filmequipment_test
JWT_ALGORITHM=HS256
ACCESS_TOKEN_SECRET=test_access_secret_change_me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=test_refresh_secret_change_me
REFRESH_TOKEN_EXPIRES=7d
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads-test
MAX_FILES_PER_USER=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=false

# Email (tests typically mock sending; include minimal placeholders only)
EMAIL_FROM=test@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
OAUTH_CLIENT_ID=
