PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/filmequipment

# Explicitly enable mock dev login in development only when needed
# Set to 'true' to allow back-door login without MongoDB (for local dev only)
ENABLE_DEV_LOGIN=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_SECRET=dev_access_secret_change_me
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me
REFRESH_TOKEN_EXPIRES=7d
# Email (optional) — prefer OAuth2 or provider API; avoid storing plain passwords
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Or use a transactional email provider API
SENDGRID_API_KEY=
OPENAI_API_KEY=
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
MAX_FILES_PER_USER=50
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,image/webp
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

